<mvc:View   
            controllerName="com.logaligroup.invoices.controller.InvoicesList"
            xmlns="sap.m"
            xmlns:core="sap.ui.core"
            xmlns:mvc="sap.ui.core.mvc">

        <List
                id="invoices"
                class="sapUiResponsiveMargin"
                width="auto"
                items="{
                    path: 'northwind>/Invoices',
                    sorter: {
                        path: 'ShipperName',
                        group: true
                    }
                }">

            <headerToolbar>

                <Toolbar>

                    <Title text="{i18n>invoicesListTitle}" level="H1"/>

                    <ToolbarSpacer/>

                    <ComboBox   id="status"
                                items="{invoices>/Status}"
                                change="onFilterPress"
                                selectedKey="00">
                        <core:Item key="{invoices>key}" text="{invoices>descr}"/>
                    </ComboBox>

                    <SearchField id="searchField"
                                search="onFilterPress" 
                                width="30%"
                                class="sapUiSmallMarginEnd"/>

                </Toolbar>
            
            </headerToolbar>

            <items>

                <ObjectListItem
                                title="{northwind>Quantity} x {northwind>ProductName}"
                                number="{
                                    parts:[
                                        'northwind>ExtendedPrice',
                                        'currency>/myCurrency'
                                    ],
                                    type: 'sap.ui.model.type.Currency',
                                    formatOptions: {
                                        showMeasure: false
                                    }
                                }"
                                numberUnit="{currency>/myCurrency}"
                                numberState="{=
                                    ( ${northwind>ExtendedPrice} >= 00.00 &amp;&amp; ${northwind>ExtendedPrice} &lt;= 9.99 )? 'Error' : 
                                    ( ${northwind>ExtendedPrice} >= 10.00 &amp;&amp; ${northwind>ExtendedPrice} &lt;= 19.99 )? 'Warning' :
                                    ( ${northwind>ExtendedPrice} >= 20.00 &amp;&amp; ${northwind>ExtendedPrice} &lt;= 39.99 )? 'Success' : 'Information'
                                }">
                    
                    <!-- <firstStatus>

                        <ObjectStatus 
                        core:require="{
                            MyFormatter: 'com/logaligroup/invoices/model/formatter'
                        }"
                        text="{
                                path: 'invoices>Status',
                                formatter: 'MyFormatter.statusText.bind($controller)'
                        }" />
                    
                    </firstStatus> -->

                </ObjectListItem>
            
            </items>
        
        </List>

</mvc:View>