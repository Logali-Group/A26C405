{
  "_version": "1.82.0",
  "sap.app": {
    "id": "employees",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.20.4",
      "toolsId": "b751de6a-be9c-4a66-a185-82a7acab8fa8"
    },
    "dataSources": {
      "mainService": {
        "uri": "/v2/northwind/northwind.svc/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "YSAPUI5_SRV_01": {
        "uri": "/sap/opu/odata/sap/YSAPUI5_SRV_01/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/YSAPUI5_SRV_01/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.145.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "employees.i18n.i18n"
        }
      },
      "northwind": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "zincidence": {
        "dataSource": "YSAPUI5_SRV_01",
        "preload": true,
        "settings": {
          "useBatch":false,
          "defaultUpdateMethod":"PUT"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "employees.view",
        "async": true
      },
      "routes": [
        {
          "name": "RouteMaster",
          "pattern": ":?query:",
          "target": [
            "TargetMaster"
          ]
        },
        {
          "name": "RouteDetails",
          "pattern": "Employee({ID}):?query:",
          "target": [
            "TargetMaster",
            "TargetDetails"
          ]
        }
      ],
      "targets": {
        "TargetContainer": {
          "name": "Container"
        },
        "TargetMaster": {
          "parent": "TargetContainer",
          "controlId": "fcl-container",
          "controlAggregation": "beginColumnPages",
          "name": "Master"
        },
        "TargetDetails": {
          "parent": "TargetContainer",
          "controlId": "fcl-container",
          "controlAggregation": "midColumnPages",
          "name": "Details"
        }
      }
    },
    "rootView": {
      "viewName": "employees.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
